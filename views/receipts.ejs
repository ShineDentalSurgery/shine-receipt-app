<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .hidden {
            display: none;
        }
        .balance-cell {
            font-weight: bold;
        }
        #scrollToBottomBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #589f14;
            color: white;
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            cursor: pointer;
            font-size: 20px;
            display: none;
            z-index: 1000;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        #scrollToBottomBtn:hover {
            background-color: #4a7c0c;
        }
    </style>
</head>

<body>
    <div class="table">


        <div class="table-specs">


            <h2>
                <%= title %>
            </h2>
            <div style="margin-bottom: 15px; display: flex; gap: 10px; align-items: center;">
                <input type="text" id="filter" placeholder="Search Patient.... " style="flex: 1;">
                <label for="filterDate" style="margin: 0; font-weight: bold;">Filter by Date:</label>
                <input type="date" id="filterDate" style="padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
                <button onclick="clearFilters()" style="padding: 8px 12px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">Clear</button>
            </div>

            <a href="/receipt/create"
                style="margin-bottom: 15px; padding: 10px 20px; background-color: #589f14; color: white; text-decoration: none; border-radius: 4px; display: inline-block;">+
                New Receipt</a>
            <button id="scrollToBottomBtn" onclick="scrollToBottom()">↓</button>
            <table>
                <thead>
                        <tr>
                        <th>Receipt ID</th>
                        <th>Patient ID</th>
                        <th>Date</th>
                        <th>Patient Name</th>
                        <th>Phone Number</th>
                        <th>Services</th>
                        <th>Total</th>
                        <th>Mode of Payment</th>
                        <th>Amount Paid</th>
                        <th>Balance</th>
                        <th>Action</th> <!-- Add this line -->
                    </tr>
                </thead>
                <tbody>
                    <% receipts.forEach(receipt=> { %>
                        <tr class="item-list">
                            <td>
                                <%= receipt.id %>
                            </td>
                            <td>
                                SDS/<%= receipt.id %>
                            </td>
                            <td>
                                <%= new Date(receipt.created_at).toLocaleDateString('en-GB') %>
                            </td>
                            <td class="names"> <a href="/receiptDetails/<%= receipt.id %>?patient_id=<%= receipt.id %>">
                                    <%= receipt.patient_name %>
                                </a> </td>
                            <td>
                                <a href="https://wa.me/<%= receipt.patient_phone.replace(/\D/g, '') %>?text=Hello%20<%= encodeURIComponent(receipt.patient_name) %>,%20your%20balance%20is%20<%= encodeURIComponent(receipt.balance) %>."
                                    target="_blank" style="color: #25D366; text-decoration: none;"
                                    title="Send WhatsApp message">
                                    <%= receipt.patient_phone %>
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg"
                                            alt="WhatsApp" style="height:16px;vertical-align:middle;margin-left:4px;">
                                </a>
                            </td>
                            <td>
                                <%= receipt.service %>
                            </td>
                        <td><span style="font-weight: bold;"><%= Number(receipt.total).toLocaleString('en-US') %></span></td>
                        <td><%= receipt.mode_of_payment %></td>
                        <td><span style="font-weight: bold;">UGX<%= Number(receipt.amount_paid).toLocaleString('en-US') %></span></td>
                        <td><span class="balance-cell" data-balance="<%= receipt.balance %>" style="font-weight: bold;"></span></td>
                            <td>
                                <% if (user && user.usertype==='admin' ) { %>
                                    <button onclick="deleteReceipt('<%= receipt.id %>')"
                                        style="color: white;">Delete</button>
                                    <% } %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <script>
        // Format balance cells with color and text
        document.querySelectorAll(".balance-cell").forEach(balanceCell => {
            const balance = Number(balanceCell.getAttribute('data-balance'));
            const color = balance > 0 ? '#dc3545' : '#28a745';
            const text = balance > 0 ? 'UGX ' + balance.toLocaleString('en-US') : 'Paid';
            balanceCell.style.color = color;
            balanceCell.textContent = text;
        });

        function applyFilters() {
            const searchValue = document.getElementById('filter').value.toLowerCase();
            const dateValue = document.getElementById('filterDate').value;
            const rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                const cells = row.querySelectorAll("td");
                let searchMatch = searchValue === ''; // Default to true if no search
                let dateMatch = dateValue === ''; // Default to true if no date selected

                // Check search match if search has value
                if (searchValue !== '') {
                    cells.forEach(cell => {
                        if (cell.textContent.toLowerCase().includes(searchValue)) {
                            searchMatch = true;
                        }
                    });
                }

                // Check date match if date is selected (date is in 3rd column)
                if (dateValue) {
                    const dateCell = cells[2]; // Date is the 3rd column
                    if (dateCell) {
                        const rowDate = new Date(dateCell.textContent.trim()).toISOString().split('T')[0];
                        dateMatch = rowDate === dateValue;
                    }
                }

                row.style.display = (searchMatch && dateMatch) ? "" : "none";
            });
        }

        function clearFilters() {
            document.getElementById('filter').value = '';
            document.getElementById('filterDate').value = '';
            applyFilters();
        }

        function scrollToBottom() {
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: 'smooth'
            });
        }

        function toggleScrollButton() {
            const btn = document.getElementById('scrollToBottomBtn');
            if (window.scrollY > 300) {
                btn.style.display = 'block';
            } else {
                btn.style.display = 'none';
            }
        }

        document.getElementById('filter').addEventListener('input', applyFilters);
        document.getElementById('filterDate').addEventListener('change', applyFilters);
        window.addEventListener('scroll', toggleScrollButton);

        function formatPhoneNumber(phoneNumber) {
            // Check if the number starts with '0' and replace it with '256'
            if (phoneNumber.startsWith('0')) {
                return '+256' + phoneNumber.slice(1);
            }
            return phoneNumber;
        }

        async function deleteReceipt(receiptId) {
            if (confirm("Are you sure you want to delete this receipt?")) {
                try {
                    const response = await fetch(`/receipts/delete/${receiptId}`, {
                        method: 'DELETE'
                    });
                    const result = await response.json();
                    if (response.ok) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert(result.message || "Error deleting receipt");
                    }
                } catch (error) {
                    alert("Error deleting receipt");
                }
            }
        }

        // Example usage for formatting phone numbers
        document.querySelectorAll(".patient-phone").forEach(phoneElement => {
            const formattedNumber = formatPhoneNumber(phoneElement.textContent.trim());
            phoneElement.textContent = formattedNumber;
        });
    </script>
</body>

</html>

<%- include('partials/footer') %>