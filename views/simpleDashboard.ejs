<section class="dashboard-simple">
    <div class="dashboard-header">
        <h1><i class="fa-solid fa-gauge-high"></i> Welcome</h1>
        <p class="lead">Today's sales and balances at a glance.</p>
    </div>

    <!-- Daily Metrics Row -->
    <div class="dash-grid">
        <div class="dash-card metrics-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-chart-line fa-lg"></i> Daily Sales</h3>
                <span class="stat large-stat"><%= dailySales %></span>
            </div>
            <div class="card-body">
                <p class="metric-label">Transactions: <strong><%= todayReceiptsCount %></strong></p>
            </div>
        </div>

        <div class="dash-card metrics-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-wallet fa-lg"></i> Amount Paid</h3>
                <span class="stat large-stat"><%= dailyAmountPaid %></span>
            </div>
            <div class="card-body">
                <p class="metric-label">Today's Payments</p>
            </div>
        </div>

        <div class="dash-card metrics-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-balance-scale fa-lg"></i> Daily Balance</h3>
                <span class="stat large-stat balance-stat"><%= dailyBalance %></span>
            </div>
            <div class="card-body">
                <p class="metric-label">Outstanding Balance</p>
            </div>
        </div>

        <!-- <div class="dash-card metrics-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-chart-bar fa-lg"></i> Sales Report</h3>
            </div>
            <div class="card-body">
                <p class="metric-label">View classified sales by payment method</p>
                <div class="card-actions">
                    <a href="/sales" class="btn btn-primary"><i class="fa-solid fa-chart-bar"></i> View Sales</a>
                </div>
            </div>
        </div> -->
    </div>

    <!-- Receipts and Invoices Section -->
    <div class="dash-grid">
        <div class="dash-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-receipt fa-lg"></i> Receipts</h3>
                <span class="stat">
                    <%= receiptsCount %>
                </span>
            </div>

            <div class="card-body">
                <div class="card-actions">
                    <a href="/receipts" class="btn btn-outline"><i class="fa-solid fa-list"></i> View</a>
                    <a href="/receipt/create" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> New</a>
                </div>

                <% if (recentReceipts && recentReceipts.length) { %>
                    <ul class="recent-list">
                        <% recentReceipts.forEach(function(r){ %>
                            <li><a href="/receipts/<%= r.id %>"><i class="fa-regular fa-circle-check"></i>
                                    <%= r.patient_name %> — <%= r.total %>
                                </a></li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p class="muted">No recent receipts</p>
                        <% } %>
            </div>
        </div>

        <div class="dash-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-file-invoice-dollar fa-lg"></i> Invoices</h3>
                <span class="stat">
                    <%= invoicesCount %>
                </span>
            </div>

            <div class="card-body">
                <div class="card-actions">
                    <a href="/invoices" class="btn btn-outline"><i class="fa-solid fa-list"></i> View</a>
                    <a href="/invoices/new" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> New</a>
                </div>

                <% if (recentInvoices && recentInvoices.length) { %>
                    <ul class="recent-list">
                        <% recentInvoices.forEach(function(i){ %>
                            <li><a href="/invoices/<%= i.id %>"><i class="fa-regular fa-circle-check"></i>
                                    <%= i.client_name || i.invoice_number %> — <%= i.total %>
                                </a></li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p class="muted">No recent invoices</p>
                        <% } %>
            </div>
        </div>
        <div class="dash-card">
            <div class="card-head">
                <h3><i class="fa-solid fa-file-invoice-dollar fa-lg"></i> Blank Page</h3>
                <a href="/blank" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> New</a>

            </div>


        </div>
    </div>
</section>